# Copy to .env and add your Groq API key. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# auto uses Groq when a key exists and falls back to local mock responses otherwise.
LLM_MODE=auto
DATABASE_URL=sqlite:///./inlinegraph.db
LANGGRAPH_CHECKPOINT_DB=./inlinegraph-checkpoints.sqlite
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
